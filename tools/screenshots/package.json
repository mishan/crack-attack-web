{
  "name": "@crack-attack/screenshots",
  "version": "0.0.0",
  "private": true,
  "description": "The README's screenshots and an accessibility audit, taken from the built game.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "shoot": "shotbox exec --net loopback --env PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.cache/ms-playwright} -- node shoot.mjs",
    "a11y": "shotbox run --a11y --net loopback --screen 1280x800 --env PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.cache/ms-playwright} -- node a11y.mjs"
  },
  "devDependencies": {
    "playwright": "~1.63.0",
    "shotbox": "^0.9.0"
  }
}
